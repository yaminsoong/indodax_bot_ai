{
  "name": "indodax-crypto-bot",
  "version": "2.0.0",
  "description": "Indodax Auto Trading Bot - manajemen risiko ATR, backtest, rekonsiliasi order",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && npm run copy:assets",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "copy:assets": "node scripts/copy-assets.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/Auto",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:restart": "npm run build && pm2 restart indodax-bot",
    "pm2:stop": "pm2 stop indodax-bot",
    "pm2:logs": "pm2 logs indodax-bot",
    "pm2:status": "pm2 status",
    "config:audit": "node scripts/config-audit.js",
    "telegram:setup": "node scripts/telegram-setup.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "node-telegram-bot-api": "^0.66.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
