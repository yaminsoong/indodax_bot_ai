# ============================================================
# INDODAX CRYPTO BOT v2 - Konfigurasi
# ============================================================
# Salin file ini ke .env lalu isi nilai Anda.
# Semua parameter di bawah juga bisa diubah saat bot berjalan
# lewat Telegram (/set) atau dashboard, dan override-nya
# tersimpan di database.

# ─── Indodax API ────────────────────────────────────────────
# Buat di: https://indodax.com/account/settings/api
# PENTING: aktifkan izin TRADE saja. JANGAN aktifkan WITHDRAW.
# Pasang juga IP whitelist bila server Anda punya IP tetap.
INDODAX_API_KEY=your_api_key_here
INDODAX_SECRET_KEY=your_secret_key_here

# Versi protokol private API: auto | v1 | v2
#
# Indodax punya DUA private API yang TIDAK saling menerima
# kunci. Kunci yang dibuat lewat menu "Trade API" modern
# adalah kunci TAPIv2; kunci lama hanya berlaku di TAPI lama.
#
# Memakai kunci di versi yang salah menghasilkan galat -2015
# "Access denied" yang menyebut izin, akun terkunci, dan IP —
# versi kuncinya disebut paling akhir, sehingga nyaris selalu
# disalahartikan. Biarkan 'auto': bot memeriksanya sendiri
# saat startup dan menuliskan hasilnya di log.
INDODAX_API_VERSION=auto

# Toleransi selisih waktu untuk TAPIv2 (milidetik).
# Bot mengoreksi jamnya sendiri terhadap server Indodax, jadi
# nilai ini jarang perlu diubah.
INDODAX_RECV_WINDOW=10000

# ─── Mode ───────────────────────────────────────────────────
# SIMULATION : tanpa order nyata (WAJIB dipakai sampai backtest
#              dan walk-forward Anda periksa sendiri)
# LIVE       : order sungguhan dengan uang asli
TRADING_MODE=SIMULATION

# KONFIRMASI KEDUA untuk mode LIVE.
#
# TRADING_MODE=LIVE saja TIDAK CUKUP. Bot hanya mengirim order
# sungguhan bila baris di bawah berisi persis:
#
#   LIVE_TRADING_CONFIRMED=I_UNDERSTAND_REAL_MONEY
#
# Alasannya: "LIVE" adalah satu kata yang gampang tertinggal
# dari sesi pengujian atau ikut tersalin dari .env mesin lain.
# Frasa ini tidak pernah muncul secara kebetulan.
#
# Bila TRADING_MODE=LIVE tetapi konfirmasi ini kosong, bot TETAP
# BERJALAN — dalam mode SIMULATION, dengan peringatan mencolok
# di log. Isi hanya setelah backtest, walk-forward, dan uji
# simulasi benar-benar Anda periksa sendiri.
LIVE_TRADING_CONFIRMED=

# Modal virtual untuk mode simulasi
SIMULATION_CAPITAL_IDR=10000000

# ─── Pair & timeframe ───────────────────────────────────────
# Pisahkan dengan koma. Pair yang tidak ada di Indodax akan
# dilewati dan diperingatkan saat startup.
# auto  = ikuti pasar Indodax (pair paling likuid, disegarkan tiap 6 jam)
# daftar = tentukan sendiri, mis. btcidr,ethidr,bnbidr
#
# Mode auto memilih pair bervolume terbesar, menyingkirkan stablecoin
# (USDT/IDR volumenya terbesar di Indodax tetapi "tren"-nya adalah
# kurs rupiah, bukan perilaku kripto) dan pair yang sedang maintenance.
TRADING_PAIRS=auto
TRADING_UNIVERSE_SIZE=8
TRADING_UNIVERSE_MIN_VOLUME_IDR=1000000000
# Dipakai sementara sebelum penyegaran pertama selesai.
TRADING_PAIRS_FALLBACK=btcidr,ethidr

# Timeframe utama (menit). HANYA nilai ini yang diterima
# Indodax: 1, 5, 15, 30, 60, 240
# (360 dan 720 DITOLAK meski terlihat wajar — bot akan
# menolaknya saat startup, bukan diam-diam gagal.)
CANDLE_TIMEFRAME=15
CANDLE_LIMIT=200

# Timeframe lebih tinggi untuk filter arah tren.
# Pilihan sama seperti di atas, dan harus lebih besar.
HTF_TIMEFRAME=60

# ─── Ukuran posisi & risiko ─────────────────────────────────
# Persen ekuitas yang DIPERTARUHKAN per trade (bukan persen
# modal yang dibelanjakan). Ukuran posisi dihitung otomatis
# dari jarak ke stop loss. 0.5-2% adalah rentang wajar.
RISK_PER_TRADE_PERCENT=1.0

# Batas atas modal untuk satu posisi, berapa pun ketatnya stop
MAX_POSITION_PERCENT=20

MAX_CONCURRENT_TRADES=3

# Maksimum posisi per kelompok aset berkorelasi.
# btcidr+ethidr bergerak hampir bersamaan; membatasinya ke 1
# mencegah tiga posisi yang sebenarnya satu taruhan.
MAX_POSITIONS_PER_GROUP=1

# ─── Kill switch ────────────────────────────────────────────
# Bot berhenti membuka posisi baru bila salah satu tercapai.
# Posisi terbuka tetap dimonitor dan stop loss tetap aktif.
MAX_DAILY_LOSS_PERCENT=5.0
MAX_DRAWDOWN_PERCENT=15
MAX_CONSECUTIVE_LOSSES=4

# Saklar manual; diubah oleh /pause dan /resume
TRADING_ENABLED=true

# ─── Stop loss & target (berbasis ATR) ──────────────────────
# Stop = harga - (ATR × pengali), dibatasi rentang min/max.
# Berbasis volatilitas, sehingga otomatis menyesuaikan
# antara BTC dan altcoin.
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=3.0
MIN_STOP_PERCENT=0.8
MAX_STOP_PERCENT=6.0

# Kunci stop di titik impas (termasuk fee) setelah profit N×R
BREAK_EVEN_AT_R=1.0

# Jual sebagian di N×R untuk mengunci profit
# Take profit bertingkat. Porsi dihitung dari posisi AWAL,
# bukan sisa: TP1 30% + TP2 30% menjual 30% dua kali, bukan
# 30% lalu 30% dari sisa 70% (yang cuma 21%) — kesalahan itu
# menyisakan remah posisi di bawah minimum order.
#
# Tingkat terakhir selalu menutup seluruh sisa.
TP1_AT_R=1.0
TP1_CLOSE_PERCENT=30
TP2_AT_R=2.0
TP2_CLOSE_PERCENT=30
TP3_AT_R=3.5
TP3_CLOSE_PERCENT=40

# Lebar zona entry sebagai kelipatan ATR. Entry ditolak bila
# harga sudah lari di atas batas atas zona — setup yang sama
# pada harga yang jauh berbeda bukan setup yang sama.
ENTRY_ZONE_ATR_MULTIPLIER=0.4

# Trailing stop mengikuti harga sejarak ATR × pengali
TRAILING_ATR_MULTIPLIER=2.0

# Tutup paksa posisi yang menggantung lebih lama dari ini (jam)
MAX_HOLDING_HOURS=48

# ─── Filter sinyal ──────────────────────────────────────────
MIN_SIGNAL_STRENGTH=60

# Wajib searah tren timeframe tinggi
REQUIRE_HTF_TREND=true

# ADX di bawah nilai ini = pasar tanpa tren. Strategi EMA
# crossover menghasilkan sinyal palsu beruntun di kondisi ini.
MIN_ADX=20

# Choppiness di atas nilai ini = sideways
MAX_CHOPPINESS=61.8

# Tolak pair dengan spread lebih lebar dari ini (likuiditas tipis)
MAX_SPREAD_PERCENT=0.6

# Tolak bila order book terlalu condong ke sisi jual (-1..1)
MIN_ORDERBOOK_IMBALANCE=-0.2

# Volume 24 jam minimum agar pair layak ditradingkan
MIN_VOLUME_IDR_24H=500000000

# Jeda sebelum masuk lagi ke pair yang baru saja merugi (menit)
COOLDOWN_MINUTES_AFTER_LOSS=60

# ─── Eksekusi ───────────────────────────────────────────────
# Bantalan harga limit agar order bertemu likuiditas
SLIPPAGE_TOLERANCE_PERCENT=0.5

# Batas tunggu order terisi; sisanya dibatalkan (detik)
ORDER_FILL_TIMEOUT_SECONDS=90

# --- Eksekusi maker (penghemat biaya terbesar) ---
# Fee Indodax: maker 0,1% vs taker 0,2%. Memasang entry sebagai
# limit pasif memangkas biaya bolak-balik dari 0,4% jadi 0,2%.
#
# Konsekuensinya: order hanya terisi bila harga datang ke level
# kita, jadi sebagian peluang akan terlewat. Untuk strategi
# bertarget lebar, kehilangan sebagian entry jauh lebih murah
# daripada membayar fee dua kali lipat pada semua entry.
#
# STOP LOSS SELALU TAKER, apa pun setelan di bawah — di sana
# kepastian eksekusi lebih berharga daripada 0,1%.
MAKER_ENTRY=true

# Seberapa jauh di bawah best bid order beli dipasang (persen).
# Makin besar, makin murah harganya tapi makin jarang terisi.
MAKER_OFFSET_PERCENT=0.02

# Order maker diberi waktu lebih lama; ia memang menunggu harga.
MAKER_FILL_TIMEOUT_SECONDS=300

# Ambil profit dengan order maker juga (tidak mendesak).
MAKER_TAKE_PROFIT=true

# ─── Strategi aktif ─────────────────────────────────────────
# EMA_SCALPING_V2   : ikut tren, untuk pasar bertren
# MEAN_REVERSION_BB : lawan arah, untuk pasar sideways
# DONCHIAN_BREAKOUT : tembus tertinggi 20 bar. Paling sedikit
#                     parameter (paling kecil risiko overfitting),
#                     trade jarang dengan target lebar sehingga
#                     fee drag rendah. Win rate memang RENDAH
#                     (30-40%) — nilai sistem ini ada pada
#                     sedikit trade besar, bukan pada win rate.
ACTIVE_STRATEGY=EMA_SCALPING_V2

# ─── Telegram (opsional, sangat disarankan) ─────────────────
# Buat bot di https://t.me/BotFather
# Mengaktifkan notifikasi DAN kontrol dua arah:
# /status /positions /pnl /close /pause /resume /scan /set dll.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Server & keamanan ──────────────────────────────────────
PORT=3099

# Kunci untuk API dashboard. Bila kosong, API hanya menerima
# permintaan dari localhost.
#
# WAJIB diisi bila bot dijalankan di VPS atau diakses dari
# perangkat lain.
#
# Di balik reverse proxy (nginx, Caddy, Cloudflare) setiap
# permintaan tampak berasal dari localhost. Bot sekarang
# MENOLAK jalur localhost begitu melihat header proxy, kecuali
# TRUST_PROXY=true disetel secara sadar — tetapi mengandalkan
# topologi jaringan tetap bukan pengganti autentikasi.
#
# Mode LIVE tidak pernah menerima jalur localhost tanpa kunci.
DASHBOARD_API_KEY=

# Origin yang boleh mengakses API (pisahkan koma).
# Kosong = hanya localhost.
CORS_ORIGINS=

# ─── Database ───────────────────────────────────────────────
DATABASE_PATH=trading-bot.db

# synchronize menyesuaikan skema otomatis dari entity — praktis
# saat pengembangan, tetapi di produksi ia bisa MENGHAPUS kolom
# hanya karena entity berubah.
#
# BIARKAN KOSONG. Bila kosong, bot memutuskan sendiri:
#   - mode LIVE atau NODE_ENV=production  -> synchronize MATI,
#     migrasi dijalankan otomatis saat startup;
#   - selain itu                          -> synchronize HIDUP.
#
# Isi true/false hanya bila Anda ingin menimpa keputusan itu.
# Jalankan migrasi manual dengan: npm run migration:run
DB_SYNCHRONIZE=
DB_LOGGING=false

# ─── Reverse proxy ──────────────────────────────────────────
# Setel true HANYA bila ada reverse proxy milik Anda sendiri di
# depan bot (nginx, Caddy, Cloudflare) yang MENIMPA header
# X-Forwarded-For.
#
# Bila false (default) dan sebuah permintaan membawa header
# proxy, jalur "localhost tanpa kunci" DITOLAK. Tanpa aturan
# ini, memasang bot di balik proxy membuat setiap permintaan
# tampak berasal dari 127.0.0.1 dan langsung diterima.
TRUST_PROXY=false

# ─── Pemulihan kegagalan ────────────────────────────────────
# Posisi berstatus FAILED menahan SELURUH entry baru sampai
# statusnya jelas. Setel false hanya bila Anda benar-benar
# paham konsekuensinya.
HALT_ON_FAILED_TRADES=true

# Coba jual ulang otomatis saat pemulihan menemukan koin masih
# dipegang. Bila false, bot hanya memberi tahu dan menunggu
# tindakan manual.
RECOVERY_AUTO_RETRY=true

# ─── Risk Engine ────────────────────────────────────────────
# Rasio imbalan/risiko minimum yang diterima Risk Engine.
# 0 menonaktifkan pemeriksaan. Dengan target bawaan 2R, nilai
# 1,0 tidak pernah menolak apa pun.
MIN_RISK_REWARD=1.0

# ════════════════════════════════════════════════════════════
#  MARKET INTELLIGENCE ENGINE
# ════════════════════════════════════════════════════════════
# Lapisan analisis yang berjalan SETELAH strategi menghasilkan
# sinyal BUY. Ia hanya bisa MENOLAK trade, tidak pernah membuat
# sinyal baru.

# Hitung analisis sama sekali.
MI_ENABLED=true

# true  : keputusan NO_TRADE dan skor di bawah minimum
#         BENAR-BENAR menolak entry.
# false : analisis tetap dihitung, dicatat, dan ditampilkan,
#         tetapi tidak memblokir apa pun.
#
# Mode false berguna untuk mengumpulkan bukti: jalankan
# beberapa minggu, lalu bandingkan hasil trade per bucket skor
# lewat GET /api/trades/breakdown sebelum mempercayai skornya.
MI_ENFORCE=true

# Timeframe yang dianalisis. 1D dibentuk dengan menggabungkan
# enam candle 4H — endpoint chart Indodax menolak tf=1440.
MI_TIMEFRAMES=5m,15m,1H,4H,1D
MI_BARS_PER_TIMEFRAME=300

# ─── Bobot confluence (total harus 100) ─────────────────────
MI_WEIGHT_TREND=25
MI_WEIGHT_STRUCTURE=20
MI_WEIGHT_MOMENTUM=15
MI_WEIGHT_VOLUME=15
MI_WEIGHT_SR=10
MI_WEIGHT_VOLATILITY=5
MI_WEIGHT_ORDERBOOK=5
MI_WEIGHT_RISK_REWARD=5

# ─── No Trade Engine ────────────────────────────────────────
# Kondisi yang menolak trade APA PUN skornya.
MI_MIN_RISK_REWARD=1.5
MI_MIN_RESISTANCE_DISTANCE_PERCENT=1.0
MI_MAX_SUPPORT_DISTANCE_PERCENT=8.0
MI_MAX_ATR_PERCENT=6.0
MI_MIN_RELATIVE_VOLUME=0.5
MI_MID_RANGE_LOW=0.4
MI_MID_RANGE_HIGH=0.6
MI_MAX_TIMEFRAME_CONFLICTS=1

# ─── Skor minimum per strategi ──────────────────────────────
# Skor adalah QUALITY SCORE dari rule engine, BUKAN peluang
# profit. Jangan menaikkan ambang ini tanpa bukti dari
# walk-forward bahwa skor lebih tinggi memang lebih baik.
MI_MIN_SCORE_EMA_SCALPING_V2=65
MI_MIN_SCORE_MEAN_REVERSION_BB=70
MI_MIN_SCORE_DONCHIAN_BREAKOUT=70
MI_MIN_SCORE_DEFAULT=65

# ─── Audit & alert ──────────────────────────────────────────
# Simpan setiap keputusan analitis ke tabel signal_analysis.
MI_AUDIT_ENABLED=true

# Alert Telegram untuk setup berkualitas tinggi.
MI_ALERT_ENABLED=true
MI_ALERT_MIN_SCORE=80

# --- Market Scanner ---
# Scanner memindai SELURUH pair IDR, bukan hanya TRADING_PAIRS.
#
# Dua tahap, dan urutannya penting: penyaringan likuiditas
# memakai SATU panggilan ringkasan pasar (murah), lalu hanya
# kandidat teratas yang dianalisis Market Intelligence (mahal:
# lima timeframe per pair). Tanpa pembatasan ini, memindai 463
# pair IDR akan menghabiskan jatah rate limit yang juga
# dibutuhkan siklus trading.
#
# Volume 24 jam minimum agar sebuah pair layak dipindai.
# Modal kecil tidak boleh masuk ke pair yang susah keluar.
SCANNER_MIN_VOLUME_IDR=500000000

# Batas pair yang dianalisis penuh per pemindaian.
# 25 pair x 5 timeframe = 125 permintaan, sekitar satu menit.
SCANNER_MAX_PAIRS=25

# Skor minimum agar sebuah pair dilaporkan sebagai layak dilihat.
SCANNER_ALERT_MIN_SCORE=70

# ATR persen MINIMUM agar setup dianggap punya ruang profit.
# Sangat bergantung timeframe: ATR 15m pada BTC biasanya
# 0,1-0,4% sementara fee bolak-balik saja 0,2-0,4%. Nilai 0,4
# cocok untuk 1H ke atas; turunkan bila Anda memang trading di
# timeframe kecil dan sudah memakai entry maker.
MI_MIN_ATR_PERCENT=0.4
